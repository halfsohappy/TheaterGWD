[Unit]
Description=Gooey Control Center (Ox64)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/TheaterGWD/gooey
ExecStart=%h/TheaterGWD/Ox64/.venv/bin/gooey --host 0.0.0.0 --port 5000 --no-browser
Restart=on-failure
Environment=PYTHONUNBUFFERED=1
Environment=PATH=%h/TheaterGWD/Ox64/.venv/bin:%h/.local/bin:/usr/bin

[Install]
WantedBy=default.target
