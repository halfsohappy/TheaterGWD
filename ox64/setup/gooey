#!/bin/sh /etc/rc.common
# TheaterGWD Gooey – OpenWRT procd service
# Installed to /etc/init.d/gooey by install.sh

START=99
STOP=10
USE_PROCD=1

PYTHON="__PYTHON__"
GOOEY_SRC="__GOOEY_SRC__"

start_service() {
    procd_open_instance
    procd_set_param command \
        "$PYTHON" "$GOOEY_SRC/run.py" \
        --host 0.0.0.0 \
        --port 5000 \
        --no-browser
    procd_set_param env PYTHONUNBUFFERED=1
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "network"
}
