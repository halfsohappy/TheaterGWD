[Unit]
Description=TheaterGWD Gooey Control Center
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=__PYTHON__ __GOOEY_SRC__/run.py --host 0.0.0.0 --port 5000 --no-browser
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
